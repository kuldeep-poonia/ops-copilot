# Server Configuration
OPS_COPILOT_PORT=8080
OPS_COPILOT_ENV=development

# Database Configuration (SQLite file path)
OPS_COPILOT_DB_PATH=./data/opscopilot.db

# Authentication Secret (HMAC secret for session signing, minimum 32 characters in production)
OPS_COPILOT_AUTH_SECRET=dev-secret-key-must-be-at-least-32-chars-long!

# Confirmation Token Time-To-Live in seconds (Default: 60)
OPS_COPILOT_TOKEN_TTL_SECONDS=60

# Rate Limiting
OPS_COPILOT_RATE_LIMIT_RPS=20
OPS_COPILOT_RATE_LIMIT_BURST=40

# Action Rate Limiting (High-risk action attempts per minute per session)
OPS_COPILOT_ACTION_RATE_LIMIT=10

# Monitored Services Control API Keys (Optional overrides per service)
OPS_COPILOT_SERVICE_PAYMENT_API_KEY=dev-payment-key
OPS_COPILOT_SERVICE_AUTH_API_KEY=dev-auth-key
OPS_COPILOT_SERVICE_INVENTORY_API_KEY=dev-inventory-key
