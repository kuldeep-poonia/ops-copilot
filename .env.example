# ==============================================================================
# Ops Co-pilot Environment Configuration Template
# Copy this file to .env and configure your production credentials.
# ==============================================================================

# --- Backend Server Configuration ---
PORT=8080
OPS_COPILOT_PORT=8080
OPS_COPILOT_ENV=production

# --- Database Storage ---
OPS_COPILOT_DB_PATH=./data/opscopilot.db

# --- Security & HMAC Secret (Mandatory in production, minimum 32 chars) ---
OPS_COPILOT_AUTH_SECRET=your-secure-random-32-character-secret-key-here!

# --- Guardrail Token TTL (Seconds before high-risk confirmation expires) ---
OPS_COPILOT_TOKEN_TTL_SECONDS=60

# --- Token Bucket Rate Limiting ---
OPS_COPILOT_RATE_LIMIT_RPS=20
OPS_COPILOT_RATE_LIMIT_BURST=40
OPS_COPILOT_ACTION_RATE_LIMIT=10

# --- CORS Allowed Origins (Comma-separated list of trusted frontend domains) ---
OPS_COPILOT_ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:5173

# --- Monitored Infrastructure Service ---
MONITORED_SERVICE_NAME=Production Microservice Gateway
MONITORED_SERVICE_URL=https://api.your-service.com
RENDER_SERVICE_ID=srv-xxxxxxxxxxxxxxxxxxxx
RENDER_API_KEY=rnd_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Frontend Client Configuration (Vite) ---
VITE_API_URL=https://your-backend.onrender.com
VITE_AUTH_SECRET=your-secure-random-32-character-secret-key-here!
